# PartyKit host. Local: 127.0.0.1:1999 — Prod: wee-golf.<user>.partykit.dev (no protocol)
NEXT_PUBLIC_PARTYKIT_HOST=127.0.0.1:1999

# Optional override for the QR base URL. Only needed locally so the QR points
# at your LAN IP instead of localhost. Leave UNSET on Vercel: production uses
# window.location.origin, which is already correct.
# NEXT_PUBLIC_APP_URL=http://192.168.1.42:3000
